# ---- Mandi ERP API — environment (AWS EC2 / production) ----
# Copy to .env on the server and fill in real values.

NODE_ENV=production

# Port the NestJS API listens on (nginx proxies /mandi/api -> this).
PORT=3002

# --- Database ---
# Option A: managed Postgres (Supabase / RDS) — requires SSL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSL=true
# Option B: Postgres installed on the same EC2 box — no SSL:
#   DATABASE_URL=postgresql://mandi:mandi@127.0.0.1:5432/mandi_erp
#   DB_SSL=false

# Auto-create the schema from entities (no migrations in this project).
DB_SYNC=true

# Frontend origin for CORS. Same-origin sub-path deploy, so this is the domain.
CORS_ORIGIN=https://nexussoftlab.com
